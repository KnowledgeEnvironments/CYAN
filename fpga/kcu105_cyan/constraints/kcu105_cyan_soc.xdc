# KCU105 CP2105 USB-UART, standard channel.
set_property PACKAGE_PIN K26 [get_ports uart_txd]
set_property IOSTANDARD LVCMOS18 [get_ports uart_txd]
set_property PACKAGE_PIN G25 [get_ports uart_rxd]
set_property IOSTANDARD LVCMOS18 [get_ports uart_rxd]
set_property PACKAGE_PIN K27 [get_ports uart_rts]
set_property IOSTANDARD LVCMOS18 [get_ports uart_rts]
set_property PACKAGE_PIN L23 [get_ports uart_cts]
set_property IOSTANDARD LVCMOS18 [get_ports uart_cts]

# KCU105 J73 cooling fan low-side PWM gate.
# Without an FPGA driver, R422 pulls this signal high at full speed.
set_property PACKAGE_PIN AJ9 [get_ports sm_fan_pwm]
set_property IOSTANDARD LVCMOS18 [get_ports sm_fan_pwm]
set_property DRIVE 8 [get_ports sm_fan_pwm]
set_property SLEW SLOW [get_ports sm_fan_pwm]

# KCU105 onboard Marvell 88E1111 SGMII-over-LVDS PHY.
set_property PACKAGE_PIN M24 [get_ports sgmii_txn]
set_property IOSTANDARD DIFF_HSTL_I_18 [get_ports sgmii_txn]
set_property PACKAGE_PIN N24 [get_ports sgmii_txp]
set_property IOSTANDARD DIFF_HSTL_I_18 [get_ports sgmii_txp]
set_property PACKAGE_PIN P25 [get_ports sgmii_rxn]
set_property IOSTANDARD DIFF_HSTL_I_18 [get_ports sgmii_rxn]
set_property PACKAGE_PIN P24 [get_ports sgmii_rxp]
set_property IOSTANDARD DIFF_HSTL_I_18 [get_ports sgmii_rxp]
set_property PACKAGE_PIN P26 [get_ports sgmii_refclk_p]
set_property IOSTANDARD LVDS_25 [get_ports sgmii_refclk_p]
set_property PACKAGE_PIN N26 [get_ports sgmii_refclk_n]
set_property IOSTANDARD LVDS_25 [get_ports sgmii_refclk_n]
set_property PACKAGE_PIN L25 [get_ports phy_mdc]
set_property IOSTANDARD LVCMOS18 [get_ports phy_mdc]
set_property PACKAGE_PIN H26 [get_ports phy_mdio]
set_property IOSTANDARD LVCMOS18 [get_ports phy_mdio]
set_property PACKAGE_PIN J23 [get_ports phy_rst_n]
set_property IOSTANDARD LVCMOS18 [get_ports phy_rst_n]
set_property PULLUP true [get_ports phy_mdio]
create_clock -name sgmii_refclk625 -period 1.600 [get_ports sgmii_refclk_p]

# KCU105 onboard micro-SD J83 through SDIO mux, SPI mode.
# SYSCTLR_SDIO_MUX_SEL must select FPGA U1 before these pins see the card.
set_property PACKAGE_PIN AD9 [get_ports sdio_cmd_fpga]
set_property IOSTANDARD LVCMOS18 [get_ports sdio_cmd_fpga]
set_property DRIVE 8 [get_ports sdio_cmd_fpga]
set_property PACKAGE_PIN AL10 [get_ports sdio_clk_fpga]
set_property IOSTANDARD LVCMOS18 [get_ports sdio_clk_fpga]
set_property DRIVE 8 [get_ports sdio_clk_fpga]
set_property PACKAGE_PIN AP9 [get_ports sdio_data0_fpga]
set_property IOSTANDARD LVCMOS18 [get_ports sdio_data0_fpga]
set_property PACKAGE_PIN AN9 [get_ports sdio_data1_fpga]
set_property IOSTANDARD LVCMOS18 [get_ports sdio_data1_fpga]
set_property PULLUP true [get_ports sdio_data1_fpga]
set_property PACKAGE_PIN AH9 [get_ports sdio_data2_fpga]
set_property IOSTANDARD LVCMOS18 [get_ports sdio_data2_fpga]
set_property PULLUP true [get_ports sdio_data2_fpga]
set_property PACKAGE_PIN AH8 [get_ports sdio_data3_fpga]
set_property IOSTANDARD LVCMOS18 [get_ports sdio_data3_fpga]
set_property DRIVE 8 [get_ports sdio_data3_fpga]
set_property PULLUP true [get_ports sdio_data3_fpga]
set_property PACKAGE_PIN AM10 [get_ports sdio_cd_fpga]
set_property IOSTANDARD LVCMOS18 [get_ports sdio_cd_fpga]
set_property PULLUP true [get_ports sdio_cd_fpga]

# KCU105 onboard ADV7511 parallel video and control bus.
set_property PACKAGE_PIN AF13 [get_ports hdmi_out_clk]
set_property PACKAGE_PIN AE13 [get_ports hdmi_hsync]
set_property PACKAGE_PIN AH13 [get_ports hdmi_vsync]
set_property PACKAGE_PIN AE11 [get_ports hdmi_data_e]
set_property PACKAGE_PIN AK11 [get_ports {hdmi_data[0]}]
set_property PACKAGE_PIN AP11 [get_ports {hdmi_data[1]}]
set_property PACKAGE_PIN AP13 [get_ports {hdmi_data[2]}]
set_property PACKAGE_PIN AN13 [get_ports {hdmi_data[3]}]
set_property PACKAGE_PIN AN11 [get_ports {hdmi_data[4]}]
set_property PACKAGE_PIN AM11 [get_ports {hdmi_data[5]}]
set_property PACKAGE_PIN AN12 [get_ports {hdmi_data[6]}]
set_property PACKAGE_PIN AM12 [get_ports {hdmi_data[7]}]
set_property PACKAGE_PIN AL12 [get_ports {hdmi_data[8]}]
set_property PACKAGE_PIN AK12 [get_ports {hdmi_data[9]}]
set_property PACKAGE_PIN AL13 [get_ports {hdmi_data[10]}]
set_property PACKAGE_PIN AK13 [get_ports {hdmi_data[11]}]
set_property PACKAGE_PIN AD11 [get_ports {hdmi_data[12]}]
set_property PACKAGE_PIN AH12 [get_ports {hdmi_data[13]}]
set_property PACKAGE_PIN AG12 [get_ports {hdmi_data[14]}]
set_property PACKAGE_PIN AJ11 [get_ports {hdmi_data[15]}]
set_property PACKAGE_PIN AE12 [get_ports hdmi_spdif]
set_property PACKAGE_PIN J24 [get_ports hdmi_iic_scl]
set_property PACKAGE_PIN J25 [get_ports hdmi_iic_sda]
set_property PACKAGE_PIN AP10 [get_ports hdmi_iic_mux_reset_n]
set_property IOSTANDARD LVCMOS18 [get_ports {hdmi_out_clk hdmi_hsync hdmi_vsync hdmi_data_e hdmi_data[*] hdmi_spdif hdmi_iic_scl hdmi_iic_sda hdmi_iic_mux_reset_n}]
set_property DRIVE 8 [get_ports {hdmi_out_clk hdmi_hsync hdmi_vsync hdmi_data_e hdmi_data[*] hdmi_spdif}]
set_property DRIVE 8 [get_ports hdmi_iic_mux_reset_n]
set_property SLEW SLOW [get_ports hdmi_iic_mux_reset_n]
set_property SLEW FAST [get_ports {hdmi_out_clk hdmi_hsync hdmi_vsync hdmi_data_e hdmi_data[*]}]
set_property PULLUP true [get_ports {hdmi_iic_scl hdmi_iic_sda}]
